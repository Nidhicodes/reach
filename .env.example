# Copy to .env. Any OpenAI-compatible endpoint works (Groq, OpenRouter, Ollama, OpenAI).
REACH_LLM_BASE_URL=https://api.groq.com/openai/v1
REACH_LLM_API_KEY=
REACH_LLM_MODEL=openai/gpt-oss-120b
# Optional: point at a FalkorDB server / FalkorDB Cloud instead of the embedded engine
# FALKORDB_HOST=
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_TLS=1          # FalkorDB Cloud TLS endpoints
# Public deploy (see reach/web.py): REACH_PUBLIC=1, REACH_RESET_MINUTES=30,
# REACH_RATE_PER_MIN=120, REACH_PUBLIC_LLM_PER_HOUR=0 (real-LLM calls off; e.g. 30 to allow)
