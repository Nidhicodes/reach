# Copy to .env. Any OpenAI-compatible endpoint works (Groq, OpenRouter, Ollama, OpenAI).
REACH_LLM_BASE_URL=https://api.groq.com/openai/v1
REACH_LLM_API_KEY=
REACH_LLM_MODEL=openai/gpt-oss-120b
# Optional: point at a FalkorDB server / FalkorDB Cloud instead of the embedded engine
# FALKORDB_HOST=
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
